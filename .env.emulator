# Usado por `npm run dev:emulador`: aponta o app para o emulador local
# (scripts/local/server.mjs). Não contém segredos — a chave abaixo é fictícia
# e só é aceita pelo emulador.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=emulador-local-sem-segredo

# Acesso rápido na tela de login (botões "Entrar como administrador/usuário").
# Somente para o emulador: as contas e a senha são as de demonstração criadas em
# scripts/local/seed.mjs (DEMO_PASSWORD). Nunca defina estas variáveis em produção.
VITE_DEMO_LOGIN=true
VITE_DEMO_PASSWORD=hv-demo-local-2026
